[Unit]
Description=VNSnowKey Vietnamese Input Method Daemon (Wayland / X11)
Documentation=https://github.com/vnsnowkey/vnsnowkey
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/vnsnowkeyd
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
KillSignal=SIGTERM

[Install]
WantedBy=graphical-session.target
